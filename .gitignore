# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is the documentation for what has to be set, and holds no values.
!.env.example

# Mail recorded locally when no provider is configured — contains real addresses.
/app/data/outbox.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local mail and SMS logs when no provider is configured — these hold real addresses and numbers.
app/data/outbox.json
app/data/sms-outbox.json

# The account store: real email addresses and password hashes. Each deployment keeps its own, so
# there is nothing here worth sharing and a committed copy would publish credentials.
app/data/users.json
