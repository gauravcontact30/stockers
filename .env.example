# Copy to `.env` and fill in. Nothing here is read at build time except NEXT_PUBLIC_* — the rest is
# read by route handlers at request time, so changing a value needs a restart, not a rebuild.
#
# Every integration below degrades rather than crashing when it is unset, with one exception noted
# against it. A fresh clone with an empty .env runs.

# --- Accounts: Supabase -----------------------------------------------------
# Unset, accounts are kept in app/data/users.json, which works locally and CANNOT work in
# production (read-only filesystem on serverless; wiped by every deploy elsewhere).
# Setup: supabase/README.md. Schema: supabase/schema.sql.
SUPABASE_URL=
# The SECRET key (`sb_secret_...`, or `service_role` on older projects) — not the publishable/anon
# one, which is governed by RLS and cannot read this table by design. Server-side only.
# Never rename this to NEXT_PUBLIC_* — that publishes a key which bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ---------------------------------------------------------------
# REQUIRED IN PRODUCTION. Session tokens are HMAC'd with this. Unset, the app falls back to a
# string committed to this repo, and anyone who has read the source can forge a session for any
# account, including the super admin.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=

# --- Admin ------------------------------------------------------------------
# SUPER_ADMIN_EMAIL is hardcoded in app/lib/admin-access.ts; these add to it. Comma-separated.
# Addresses listed here are promoted to admin when they sign up.
ADMIN_EMAILS=

# --- Where the app thinks it lives ------------------------------------------
# Used to build the verification link in the welcome email, and sent as HTTP-Referer to OpenRouter.
# Set this to the real origin in production, or the link in every welcome mail points at localhost.
#
# Deliberately NOT prefixed NEXT_PUBLIC_: that would inline the value at build time — in server
# code too — so changing it on the host would do nothing until the project was rebuilt. Nothing in
# the browser reads it. NEXT_PUBLIC_APP_URL is still honoured as a fallback for older deployments.
APP_URL=http://localhost:3000

# --- Email ------------------------------------------------------------------
# CONFIGURE ONE OF THESE OR NO MAIL LEAVES THE SERVER. With none set, verification links and
# password reset codes are only written to app/data/outbox.json, so nobody can verify an address
# or recover an account by email. The sign-in page's recovery panel says so out loud.
#
# They are tried in the order below and the first one configured wins. Every one of them is free at
# this app's volume. MAIL_FROM is required by the API providers: "StockersAI <you@domain>".
MAIL_FROM=

# 1. Resend - THE DEFAULT SENDER. Verification links and password reset codes go out through this
#    unless it is unset or failing. 3,000 emails/month free; needs a domain you can add DNS records
#    to. It is also the only provider here that sends the app's own HTML, so the reset code arrives
#    as the designed mail rather than as a panel template with the text dropped in.
#      resend.com -> API Keys, and Domains -> add + verify the domain in MAIL_FROM
RESEND_API_KEY=

# 2. MSG91 Email - fallback, and only worth setting if you want the reset mail on the same account
#    as the reset SMS. Needs a verified domain and a template built on the MSG91 panel, because
#    MSG91 renders from a template rather than accepting HTML: create one with two variables,
#    ##subject## and ##body##. Mail sent this way is MSG91's template with the plain text dropped
#    in, not the styled HTML Resend sends. Leave the template id unset to keep the designed mail.
#      msg91.com -> Email -> Domains (verify) -> Templates
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_TEMPLATE_ID=

# 3. Brevo - 300 emails/day free, no domain needed (verify a single sender address instead), no
#    card. The quickest path from nothing to working mail. brevo.com -> SMTP & API -> API keys
BREVO_API_KEY=

# 4. SendGrid - 100 emails/day free, single-sender verification. sendgrid.com
SENDGRID_API_KEY=

# 5. Plain SMTP - no new account at all if you already have a mailbox. For Gmail, turn on 2-step
#    verification and create an App Password (myaccount.google.com/apppasswords), then:
#      SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app password>
#    Implicit TLS on port 465 only - STARTTLS on 587 is deliberately not supported. See app/lib/smtp.ts.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- SMS --------------------------------------------------------------------
# Optional, and the second channel password recovery runs on: with one of these set, a locked-out
# reader gets their code by SMS even when mail is failing. Unset, messages are recorded to
# app/data/sms-outbox.json and nothing else breaks.
#
# Note: Resend is an email API and does not send SMS, so the mobile half of recovery cannot run on
# it. MSG91 is the default gateway for the code that goes to a phone; Resend is the default for the
# one that goes to an inbox. Both carry the same six digits.
#
# Commercial SMS to Indian numbers normally needs a DLT-registered sender id and template - a
# gateway will accept the call and silently drop the message otherwise. MSG91's Flow API handles
# that properly by sending against a registered template, which is why it is tried first.
#
# 1. MSG91 - tried first. Two ways to configure it:
#      Flow API (recommended)  MSG91_AUTH_KEY + MSG91_TEMPLATE_ID
#      legacy v2               MSG91_AUTH_KEY + MSG91_SENDER_ID
#    The Flow API is what MSG91 documents today and the only DLT-correct option: the wording lives
#    in an approved template and MSG91 renders it. Register the template as the sentence in
#    passwordResetSms() (app/lib/sms.ts) with the code and the expiry as ##OTP## and ##MIN##:
#      "Your StockersAI password reset code is ##OTP##. It expires in ##MIN## minutes. Do not
#       share this code with anyone."
#    MSG91_SENDER_ID stays optional alongside a template - set it only if the account has more than
#    one approved sender and MSG91 needs telling which.
#      msg91.com -> SMS -> Templates (approved on DLT) -> copy the template id
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# Optional: a template used only for password recovery, when one template per message type is
# registered. Falls back to MSG91_TEMPLATE_ID when unset.
MSG91_RESET_TEMPLATE_ID=

# 2. Twilio - trial credit, needs a card. twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# 3. Fast2SMS - free quota, no card, Indian numbers only. Its quick route sends without a
#    registered template, which makes it a usable last resort. fast2sms.com -> Dev API
FAST2SMS_API_KEY=

# --- Payments: Razorpay -----------------------------------------------------
# Unset, checkout reports itself unconfigured and the app keeps its unpaid renewal flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI: OpenRouter ---------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# --- Scheduled jobs ---------------------------------------------------------
# The daily 8:50 AM IST AI lock (`/api/cron/ai-locked-picks`, scheduled in vercel.json at
# `20 3 * * 1-5` — 03:20 UTC) locks ten BSE stocks per cap tier before the 9:15 AM open and
# replaces the previous day's list.
#
# Unset, the endpoint accepts only an admin session, and the lock falls back to being generated by
# the first page load at or after 8:50 IST — later than intended but never mid-session, since the
# list is frozen for the day once it exists. Set this in production so the scheduler can call it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel Cron sends it as `Authorization: Bearer`; other schedulers can send `x-cron-secret`.
CRON_SECRET=

# BSE holidays the lock should skip, comma-separated `YYYY-MM-DD`. Weekends are always skipped.
# On a skipped day the previous session's locked picks are held rather than replaced.
BSE_MARKET_HOLIDAYS=
